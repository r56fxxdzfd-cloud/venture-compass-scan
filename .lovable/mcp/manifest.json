{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zazebhtkxojegimdfqry.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "darwin-growth-mcp",
      "version": "0.1.0",
      "title": "Darwin Growth MCP"
    },
    "tools": [
      {
        "name": "list_startups",
        "title": "Listar startups",
        "description": "Lista as startups (companies) que o usuário autenticado tem permissão para visualizar.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Número máximo de startups a retornar (padrão 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_startup",
        "title": "Detalhes da startup",
        "description": "Retorna informações detalhadas de uma startup específica pelo ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID da startup (company)."
            }
          },
          "required": [
            "company_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_assessments",
        "title": "Listar diagnósticos",
        "description": "Lista os diagnósticos (assessments) de uma startup, ordenados do mais recente para o mais antigo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID da startup."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo de resultados (padrão 20)."
            }
          },
          "required": [
            "company_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_action_items",
        "title": "Listar plano de ação",
        "description": "Lista os itens do plano de ação de uma startup, opcionalmente filtrando por status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID da startup."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "done",
                "blocked"
              ],
              "description": "Filtro opcional por status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de itens (padrão 50)."
            }
          },
          "required": [
            "company_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
